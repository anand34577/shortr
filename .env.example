# Copy to .env and fill in before `docker compose up -d`.
# Full reference: the Configuration page of the wiki. Every SHORTR_* env var is optional except the
# ones marked (required) below — sane defaults cover the rest.

# (required in production) the public URL short links are built from.
SHORTR_BASE_URL=https://sho.rt

# (required in production) 32+ random bytes for cookie/CSRF/OIDC-state
# signing. Auto-generated into <data>/secret.key on first run if omitted —
# only set this explicitly if you need it stable across a data-dir wipe or
# to share across instances.
# SHORTR_SECRET_KEY=

# host port to publish (docker-compose.yml only; not used by the npm compose file)
SHORTR_PORT=8080

# closed | open | invite
SHORTR_REGISTRATION=closed

# Password accounts must set up an authenticator app (also in Admin → Settings)
# SHORTR_MFA_REQUIRED=false

# --- Exposure: keep the console off the internet --------------------------
# Set SHORTR_ADMIN_LISTEN to run the web console on its own port. Then
# SHORTR_LISTEN (8080) serves only redirects and a token-only API, which is
# safe to put behind a Cloudflare Tunnel, while the console, sign-in and
# admin API live on the admin port that you reach over LAN/VPN.
# Leave it unset to serve everything on one port.
# SHORTR_ADMIN_LISTEN=:8081
# The URL you type to reach the console (required with SSO in split mode).
# SHORTR_ADMIN_URL=https://shortr.home.lan
# Host port for the console in docker-compose.yml (bound to 127.0.0.1).
# SHORTR_ADMIN_PORT=8081
# API on the public port, for mobile apps and scripts. false = redirects only.
# SHORTR_PUBLIC_API=true
# Also allow admin endpoints on the public port (needs an admin:* key). Rarely wanted.
# SHORTR_PUBLIC_ADMIN_API=false
# Where a visit to the bare public domain goes (default: a 404 page).
# SHORTR_ROOT_REDIRECT=https://example.com
# Single-port mode only: false stops serving the console at all.
# SHORTR_UI_ENABLED=true

# seed the first admin non-interactively (useful for unattended first boot;
# otherwise visit /app/setup once after starting)
# SHORTR_ADMIN_EMAIL=admin@example.com
# SHORTR_ADMIN_PASSWORD=change-me-now-please

# --- OIDC / SSO (optional) ------------------------------------------------
# SHORTR_OIDC_ENABLED=true
# SHORTR_OIDC_ISSUER=https://idp.example.com
# SHORTR_OIDC_CLIENT_ID=shortr
# SHORTR_OIDC_CLIENT_SECRET=
# SHORTR_OIDC_AUTO_CREATE=false
# SHORTR_OIDC_AUTO_LINK_BY_EMAIL=false
# SHORTR_OIDC_ADMIN_GROUP=
# Accept the provider's access tokens as API Bearer tokens when their azp/aud
# is one of these client IDs (e.g. your Android app's Keycloak client).
# SHORTR_OIDC_API_AUDIENCES=shortr-android

# --- Email notifications (optional) ---------------------------------------
# SHORTR_SMTP_ENABLED=true
# SHORTR_SMTP_HOST=smtp.example.com
# starttls (port 587), tls (port 465) or none (plain relay on your LAN, port 25)
# SHORTR_SMTP_TLS=starttls
# SHORTR_SMTP_PORT=587
# accept a self-signed certificate on the mail server
# SHORTR_SMTP_INSECURE=false
# SHORTR_SMTP_USER=
# SHORTR_SMTP_PASS=
# SHORTR_SMTP_FROM=Shortr <noreply@sho.rt>

# --- Gotify push notifications (optional, self-hosted) --------------------
# SHORTR_GOTIFY_ENABLED=true
# SHORTR_GOTIFY_URL=https://gotify.example.com
# SHORTR_GOTIFY_TOKEN=

# --- PostgreSQL (only used with docker-compose.postgres.yml) --------------
# POSTGRES_PASSWORD=change-me

# --- Nginx Proxy Manager (only used with deploy/docker-compose.npm.yml) --
# SHORTR_TRUSTED_PROXIES=172.18.0.0/16
# uncomment if fronted by Cloudflare (Tunnel or orange-clouded DNS):
# SHORTR_REAL_IP_HEADER=CF-Connecting-IP
