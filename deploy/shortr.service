[Unit]
Description=Shortr URL shortener
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=shortr
WorkingDirectory=/var/lib/shortr
EnvironmentFile=-/etc/shortr/env
Environment=SHORTR_DATA_DIR=/var/lib/shortr
ExecStart=/usr/local/bin/shortr
Restart=always
RestartSec=2
LimitNOFILE=65536

# hardening (safe to drop CAP_NET_BIND_SERVICE if you're not binding <1024
# directly — recommended: put Shortr behind a reverse proxy instead and
# leave SHORTR_LISTEN at its default :8080)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/shortr

[Install]
WantedBy=multi-user.target
